<Window x:Class="AIUsageMonitor.App.Notifications.NotificationHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMonitor · notifiche"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="372" Focusable="False">
  <Window.Resources>
    <!-- ✕ della card: tondo da 20, trasparente finche' il mouse non ci passa sopra. Button marca il click Handled, quindi
         chiudere una card non la attiva anche (il click sul corpo e' un MouseLeftButtonUp della radice). -->
    <Style x:Key="CardCloseButton" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Card compatta (spec 2026-09-27 §5.2). La radice porta la trasformata che animano ingresso e uscita (X,
         opacita') e lo scorrimento al nuovo posto (Y): parte trasparente e 24 DIP a destra, la fa entrare Card_Loaded.
         L'ombra sta su uno strato separato dietro la card: un Effect sul contenuto farebbe passare anche il testo da una
         bitmap intermedia. Nessun bordo o barra laterale colorati. -->
    <DataTemplate x:Key="NotificationCardTemplate">
      <Grid x:Name="CardRoot" Margin="0,0,0,8" Opacity="0" Background="Transparent" Cursor="Hand"
            Loaded="Card_Loaded" Unloaded="Card_Unloaded"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseLeftButtonUp="Card_MouseLeftButtonUp">
        <Grid.RenderTransform>
          <TranslateTransform X="24"/>
        </Grid.RenderTransform>
        <Border CornerRadius="14" Background="{StaticResource Card}">
          <Border.Effect>
            <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="24" Opacity="0.45" ShadowDepth="4" Direction="270"/>
          </Border.Effect>
        </Border>
        <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource NotchBorder}" BorderThickness="1">
          <Grid>
            <Border CornerRadius="13" Background="{Binding GlowBrush}"/>
            <Grid Margin="12,11,10,13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Avatar da 30: il cerchio dell'agente come nella card del notch, il logo dell'app per gli avvisi. -->
              <Grid Width="30" Height="30" Margin="0,2,10,0" VerticalAlignment="Top">
                <Grid Visibility="{Binding AgentVisibility}">
                  <Ellipse Fill="{Binding BrandBrush}"/>
                  <Path Data="{Binding Icon}" Fill="{StaticResource TextPrimary}" Width="16" Height="16" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Image Source="{Binding Logo}" Visibility="{Binding LogoVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
              <StackPanel Grid.Column="1">
                <!-- Riga 1: sessione, eta', ✕ (occupa sempre il suo posto: comparendo non sposta l'eta'). -->
                <DockPanel>
                  <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CardCloseButton}" Visibility="Hidden"
                          Margin="4,-2,0,-2" Click="Dismiss_Click" ToolTip="Chiudi" AutomationProperties.Name="Chiudi">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextMuted}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Button>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding AgeText}" Foreground="{StaticResource TextMuted}" FontSize="11"
                             Margin="8,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- Riga 2: pallino ed etichetta nel colore del tipo. -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <Ellipse Width="7" Height="7" Fill="{Binding ToneBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Label}" Foreground="{Binding ToneBrush}" FontSize="11" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Riga 3: una riga di messaggio (MessageLine, senza a capo: una TextBlock li disegna anche con NoWrap),
                     il testo intero nel tooltip. -->
                <TextBlock Text="{Binding MessageLine}" ToolTip="{Binding Message}" Foreground="{StaticResource TextMuted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
            <!-- Barra del timer: 2 DIP sul bordo inferiore, rientrata del raggio degli angoli; si svuota verso sinistra
                 (ScaleX animata da NotificationHostWindow.RunTimer). -->
            <Border Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="14,0,14,0"
                    Background="{Binding TimerBrush}" Visibility="{Binding TimerVisibility}" RenderTransformOrigin="0,0.5"
                    Loaded="TimerBar_Loaded" Unloaded="TimerBar_Unloaded">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="1"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <!-- Margine di 16 DIP su ogni lato per l'ombra (ShadowMargin nel code-behind): le card sono larghe 340. -->
  <StackPanel x:Name="Stack" Margin="16" TextElement.FontFamily="{StaticResource TextFont}"
              MouseEnter="Stack_MouseEnter" MouseLeave="Stack_MouseLeave">
    <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource NotificationCardTemplate}" Focusable="False"/>
    <!-- "+N altre": clic = fissa il notch (lo decide il servizio). -->
    <Border HorizontalAlignment="Right" CornerRadius="11" Padding="10,3" Cursor="Hand"
            Background="{StaticResource Card}" BorderBrush="{StaticResource NotchBorder}" BorderThickness="1"
            Visibility="{Binding MoreVisibility}" MouseLeftButtonUp="More_MouseLeftButtonUp">
      <TextBlock Text="{Binding MoreText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
    </Border>
  </StackPanel>
</Window>
