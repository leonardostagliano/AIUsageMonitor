<Window x:Class="AIUsageMonitor.App.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMonitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="320" MinHeight="60" Focusable="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="NotchTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <!-- Default tipografici della notch sulla radice: si ereditano da pannello, linguetta e template. -->
  <Grid TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontSize="13" TextElement.FontFamily="{StaticResource TextFont}">
    <!-- Pannello espanso. Hidden (non Collapsed) da chiuso, cosi' la finestra conserva l'altezza del pannello e la
         linguetta non salta sotto il mouse. E' largo 24 px piu' della finestra e sporge oltre il bordo destro (Margin
         negativo, Padding destro compensato): la parte che sporge resta fuori dalla finestra, quindi invisibile, e lo
         scorrimento non scopre mai il bordo dello schermo. A sinistra invece non c'e' margine (la finestra resta larga
         320): l'apertura non deve superare la posizione finale, o la finestra taglierebbe gli angoli arrotondati. -->
    <Border x:Name="Panel" HorizontalAlignment="Right" Width="344" Margin="0,0,-24,0" Visibility="Hidden" Opacity="0"
            CornerRadius="24,0,0,24" Background="{StaticResource NotchBackground}"
            BorderBrush="{StaticResource NotchBorder}" BorderThickness="1,1,0,1" Padding="14,14,38,14"
            MouseLeftButtonDown="Tab_MouseLeftButtonDown">
      <Border.RenderTransform>
        <TranslateTransform x:Name="PanelSlide" X="344"/>
      </Border.RenderTransform>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,12">
          <!-- Il tooltip sta su un Border trasparente: una Path senza Fill riceve il mouse solo sul tratto da 1,6 px. -->
          <Border x:Name="PinGlyph" DockPanel.Dock="Right" Visibility="Collapsed" Background="Transparent" Padding="3" Margin="5,0,0,0"
                  VerticalAlignment="Center" ToolTip="Fissato: clicca la linguetta o l'icona nella tray per sbloccare">
            <Path Width="13" Height="13" Stretch="Uniform"
                  Data="M9,3 L15,3 L14,9 L17,12 L7,12 L10,9 Z M12,12 L12,21" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <Border DockPanel.Dock="Right" CornerRadius="11" Padding="10,3" Background="{Binding SummaryFill}"
                  Visibility="{Binding SummaryVisibility}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{Binding SummaryDot}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding SummaryText}" Foreground="{Binding SummaryForeground}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Text="AI Usage" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource AgentCardTemplate}"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Linguetta chiusa: pillola sul bordo destro, un cerchio per agente (spec 6.1). La visibilita' non cambia mai:
         durante la transizione la linguetta sfuma in opacita' (e perde l'hit test) insieme al pannello. -->
    <Border x:Name="Tab" HorizontalAlignment="Right" VerticalAlignment="Center" Width="{Binding TabWidth}" Padding="0,4" Opacity="1"
            CornerRadius="{Binding TabCornerRadius}" Background="{StaticResource NotchBackground}"
            BorderBrush="{StaticResource NotchBorder}" BorderThickness="1,1,0,1" Cursor="Hand"
            MouseEnter="Tab_MouseEnter" MouseLeftButtonDown="Tab_MouseLeftButtonDown">
      <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource TabItemTemplate}"/>
    </Border>
  </Grid>
</Window>
