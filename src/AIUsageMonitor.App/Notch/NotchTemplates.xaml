<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <DataTemplate x:Key="TabItemTemplate">
    <StackPanel Height="{Binding DataContext.TabRowHeight, RelativeSource={RelativeSource AncestorType=Window}}" Width="28">
      <Path Data="{Binding Icon}" Fill="White"
            Width="{Binding DataContext.TabIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
            Height="{Binding DataContext.TabIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
            Stretch="Uniform" HorizontalAlignment="Center" Margin="0,2,0,3"/>
      <Ellipse Width="8" Height="8" Fill="{Binding AggregateBrush}" Stroke="{Binding AggregateStroke}" StrokeThickness="1" HorizontalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="WindowRowTemplate">
    <Grid Margin="0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="66"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="42"/>
        <ColumnDefinition Width="58"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{StaticResource BarTrack}" VerticalAlignment="Center" Margin="4,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilledStar}"/>
            <ColumnDefinition Width="{Binding EmptyStar}"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="3" Background="{Binding BarBrush}"/>
        </Grid>
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding PercentText}" TextAlignment="Right" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding ResetText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>

  <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9"/>
  </Storyboard>

  <!-- Riga cliccabile senza cornice: marca il click come Handled (ButtonBase), quindi non arriva al pannello e non
       fissa/sblocca la notch come farebbe un click sullo sfondo. -->
  <Style x:Key="FlatRowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="SubagentRowTemplate">
    <Grid Margin="16,1,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="24"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="46"/>
        <ColumnDefinition Width="36"/>
      </Grid.ColumnDefinitions>
      <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPulsing}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="SubagentPulse" Storyboard="{StaticResource PulseStoryboard}"/>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="SubagentPulse"/>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding PhaseLabel}" Foreground="{Binding DotBrush}" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{Binding TokensText}" ToolTip="{Binding TokensTooltip}" Foreground="{StaticResource TextMuted}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" Foreground="{StaticResource TextMuted}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="SessionRowTemplate">
    <StackPanel Margin="0,2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*" MinWidth="28"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="52"/>
          <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPulsing}" Value="True">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse" Storyboard="{StaticResource PulseStoryboard}"/>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Pulse"/>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding PhaseLabel}" Foreground="{Binding DotBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding TokensText}" ToolTip="{Binding TokensTooltip}" Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Button Style="{StaticResource FlatRowButton}" Command="{Binding ToggleCommand}" Visibility="{Binding SummaryVisibility}" Margin="16,1,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ChevronGlyph}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SubagentSummary}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <ItemsControl ItemsSource="{Binding Subagents}" ItemTemplate="{StaticResource SubagentRowTemplate}" Visibility="{Binding SubagentListVisibility}"/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="AgentCardTemplate">
    <Border Margin="0,0,0,10" Padding="0,0,0,8" BorderBrush="{StaticResource NotchBorder}" BorderThickness="0,0,0,1">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Path Data="{Binding Icon}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <Border DockPanel.Dock="Right" CornerRadius="4" Background="{StaticResource Badge}" Padding="6,1" Visibility="{Binding PlanVisibility}" VerticalAlignment="Center">
            <TextBlock Text="{Binding PlanLabel}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
          </Border>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource WindowRowTemplate}"/>
        <TextBlock Text="{Binding ExtraUsage}" Foreground="{StaticResource TextMuted}" FontSize="11" Visibility="{Binding ExtraVisibility}"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Amber}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding StatusVisibility}" Margin="0,2,0,0"/>
        <TextBlock FontSize="11" Margin="0,4,0,0" Visibility="{Binding HookWarningVisibility}">
          <Run Text="Stato live non attivo: " Foreground="{StaticResource TextMuted}"/><Hyperlink Command="{Binding InstallHooksCommand}" Foreground="{StaticResource Amber}" TextDecorations="None">installa hook</Hyperlink>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRowTemplate}" Margin="0,4,0,0"/>
        <TextBlock Text="nessuna sessione attiva" Foreground="{StaticResource TextMuted}" FontSize="11" Visibility="{Binding NoSessionsVisibility}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
