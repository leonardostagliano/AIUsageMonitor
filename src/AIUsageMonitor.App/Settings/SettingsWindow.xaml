<Window x:Class="AIUsageMonitor.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMonitor · Impostazioni" Width="560" MinWidth="520" SizeToContent="Height" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{StaticResource TextPrimary}">
  <!-- Nessuno stile locale: i controlli prendono quelli impliciti scuri di Assets/Controls.xaml (margini, raggi,
       padding compresi), cosi' la finestra e il notch restano coerenti. La barra del titolo la scurisce DWM in
       OnSourceInitialized (DarkTitleBar), il tetto all'altezza lo mette ApplyWorkAreaCap con l'area di lavoro del
       monitor reale: su schermi bassi la ScrollViewer mostra la barra invece di far tagliare il contenuto. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,16,18,14">

      <GroupBox Header="AGENTI">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <CheckBox Content="Claude Code" IsChecked="{Binding ClaudeEnabled}"/>
          <Label Grid.Column="1" Content="refresh (s)"/>
          <TextBox Grid.Column="2" Text="{Binding ClaudeRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="1" Content="Codex" IsChecked="{Binding CodexEnabled}"/>
          <Label Grid.Row="1" Grid.Column="1" Content="refresh (s)"/>
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CodexRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Codex: rileva i thread figli dai rollout" IsChecked="{Binding CodexSubagentFallback}"
                    ToolTip="Conta i thread figli di Codex leggendo i file di rollout, utile finché i gruppi hook di Codex non sono approvati con /hooks. Per le sessioni i cui hook riportano già i subagenti viene ignorato automaticamente."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="NOTCH">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Monitor"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedIndex="{Binding MonitorIndex}"/>
          <Label Grid.Row="1" Content="Offset verticale (px)"/>
          <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"/>
          <Label Grid.Row="2" Content="Ritardo di chiusura (ms)"/>
          <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding CollapseDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Modalità compatta (icone più piccole)" IsChecked="{Binding Compact}"/>
        </Grid>
      </GroupBox>

      <GroupBox Header="HOOK (STATO LIVE)">
        <StackPanel>
          <TextBlock Text="{Binding ClaudeHookStatus, StringFormat=Claude Code: {0}}" Margin="0,2" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Installa" Command="{Binding InstallClaudeHooksCommand}"/>
            <Button Content="Rimuovi" Command="{Binding RemoveClaudeHooksCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding CodexHookStatus, StringFormat=Codex: {0}}" Margin="0,10,0,2" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Installa" Command="{Binding InstallCodexHooksCommand}"/>
            <Button Content="Rimuovi" Command="{Binding RemoveCodexHooksCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding EventsFile}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,4" TextTrimming="CharacterEllipsis"/>
          <Button Content="Apri cartella" Command="{Binding OpenEventsFolderCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="NOTIFICHE">
        <StackPanel>
          <CheckBox Content="Attende input" IsChecked="{Binding NotifyNeedsInput}"/>
          <CheckBox Content="Turno completato" IsChecked="{Binding NotifyTurnCompleted}"/>
          <CheckBox Content="Errore" IsChecked="{Binding NotifyError}"/>
          <Separator/>
          <CheckBox Content="Da Claude Code" IsChecked="{Binding NotifyClaude}"/>
          <CheckBox Content="Da Codex" IsChecked="{Binding NotifyCodex}"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="SISTEMA">
        <StackPanel>
          <CheckBox Content="Avvio automatico con Windows" IsChecked="{Binding AutoStartEnabled}"/>
          <Button Content="Apri cartella log" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Content="Annulla" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Salva" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,2,0,2"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
