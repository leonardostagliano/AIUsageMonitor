<Window x:Class="AIUsageMonitor.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMonitor · Impostazioni" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF202024">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#FFA0A0A8"/>
      <Setter Property="Padding" Value="0,3"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Width" Value="70"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0,2,6,2"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
  </Window.Resources>
  <!-- SizeToContent="Height" + ResizeMode="NoResize": su schermi con area di lavoro bassa (1366x768, o 1920x1080 al
       150%) il contenuto supera l'altezza disponibile. Senza ScrollViewer verrebbe tagliato in basso, senza barra e
       senza modo di ridimensionare; il tetto lo mette OnSourceInitialized con l'area di lavoro del monitor reale. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="14">
    <GroupBox Header="Agenti">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <CheckBox Content="Claude Code" IsChecked="{Binding ClaudeEnabled}"/>
        <Label Grid.Column="1" Content="refresh (s)"/>
        <TextBox Grid.Column="2" Text="{Binding ClaudeRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Grid.Row="1" Content="Codex" IsChecked="{Binding CodexEnabled}"/>
        <Label Grid.Row="1" Grid.Column="1" Content="refresh (s)"/>
        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CodexRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Codex: rileva i thread figli dai rollout" IsChecked="{Binding CodexSubagentFallback}"
                  ToolTip="Conta i thread figli di Codex leggendo i file di rollout, utile finché i gruppi hook di Codex non sono approvati con /hooks. Per le sessioni i cui hook riportano già i subagenti viene ignorato automaticamente."/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Notch">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="Monitor"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedIndex="{Binding MonitorIndex}" Margin="6,2"/>
        <Label Grid.Row="1" Content="Offset verticale (px)"/>
        <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="2" Content="Ritardo di chiusura (ms)"/>
        <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding CollapseDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Modalità compatta (icone più piccole)" IsChecked="{Binding Compact}"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Hook (stato live)">
      <StackPanel>
        <TextBlock Text="{Binding ClaudeHookStatus, StringFormat=Claude Code: {0}}" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Installa" Command="{Binding InstallClaudeHooksCommand}"/>
          <Button Content="Rimuovi" Command="{Binding RemoveClaudeHooksCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding CodexHookStatus, StringFormat=Codex: {0}}" Foreground="White" Margin="0,8,0,2" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Installa" Command="{Binding InstallCodexHooksCommand}"/>
          <Button Content="Rimuovi" Command="{Binding RemoveCodexHooksCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding EventsFile}" Foreground="#FFA0A0A8" FontSize="11" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
        <Button Content="Apri cartella" Command="{Binding OpenEventsFolderCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Notifiche">
      <StackPanel>
        <CheckBox Content="Attende input" IsChecked="{Binding NotifyNeedsInput}"/>
        <CheckBox Content="Turno completato" IsChecked="{Binding NotifyTurnCompleted}"/>
        <CheckBox Content="Errore" IsChecked="{Binding NotifyError}"/>
        <Separator Margin="0,4"/>
        <CheckBox Content="Da Claude Code" IsChecked="{Binding NotifyClaude}"/>
        <CheckBox Content="Da Codex" IsChecked="{Binding NotifyCodex}"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Sistema">
      <StackPanel>
        <CheckBox Content="Avvio automatico con Windows" IsChecked="{Binding AutoStartEnabled}"/>
        <Button Content="Apri cartella log" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Annulla" Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Salva" Command="{Binding SaveCommand}" IsDefault="True" Margin="0,2,0,2"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
