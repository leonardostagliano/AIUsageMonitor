<Window x:Class="AIUsageMonitor.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIUsageMonitor · Impostazioni" Width="560" MinWidth="520" SizeToContent="Height" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{StaticResource TextPrimary}">
  <!-- Nessuno stile locale: i controlli prendono quelli impliciti scuri di Assets/Controls.xaml (margini, raggi,
       padding compresi), cosi' la finestra e il notch restano coerenti. La barra del titolo la scurisce DWM in
       OnSourceInitialized (DarkTitleBar), il tetto all'altezza lo mette ApplyWorkAreaCap con l'area di lavoro del
       monitor reale: su schermi bassi la ScrollViewer mostra la barra invece di far tagliare il contenuto. -->
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,16,18,14">

      <GroupBox Header="AGENTI">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <CheckBox Content="Claude Code" IsChecked="{Binding ClaudeEnabled}"/>
          <Label Grid.Column="1" Content="refresh (s)"/>
          <TextBox Grid.Column="2" Text="{Binding ClaudeRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="1" Content="Codex" IsChecked="{Binding CodexEnabled}"/>
          <Label Grid.Row="1" Grid.Column="1" Content="refresh (s)"/>
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CodexRefreshSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Codex: rileva i thread figli dai rollout" IsChecked="{Binding CodexSubagentFallback}"
                    ToolTip="Conta i thread figli di Codex leggendo i file di rollout, utile finché i gruppi hook di Codex non sono approvati con /hooks. Per le sessioni i cui hook riportano già i subagenti viene ignorato automaticamente."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="NOTCH">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Monitor"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedIndex="{Binding MonitorIndex}"/>
          <Label Grid.Row="1" Content="Offset verticale (px)"/>
          <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"/>
          <Label Grid.Row="2" Content="Ritardo di chiusura (ms)"/>
          <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Text="{Binding CollapseDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Modalità compatta (icone più piccole)" IsChecked="{Binding Compact}"/>
        </Grid>
      </GroupBox>

      <GroupBox Header="HOOK (STATO LIVE)">
        <StackPanel>
          <TextBlock Text="{Binding ClaudeHookStatus, StringFormat=Claude Code: {0}}" Margin="0,2" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Installa" Command="{Binding InstallClaudeHooksCommand}"/>
            <Button Content="Rimuovi" Command="{Binding RemoveClaudeHooksCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding CodexHookStatus, StringFormat=Codex: {0}}" Margin="0,10,0,2" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Installa" Command="{Binding InstallCodexHooksCommand}"/>
            <Button Content="Rimuovi" Command="{Binding RemoveCodexHooksCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding EventsFile}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,4" TextTrimming="CharacterEllipsis"/>
          <Button Content="Apri cartella" Command="{Binding OpenEventsFolderCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="NOTIFICHE">
        <StackPanel>
          <CheckBox Content="Attende input" IsChecked="{Binding NotifyNeedsInput}"/>
          <CheckBox Content="Turno completato" IsChecked="{Binding NotifyTurnCompleted}"/>
          <CheckBox Content="Errore" IsChecked="{Binding NotifyError}"/>
          <Separator/>
          <CheckBox Content="Da Claude Code" IsChecked="{Binding NotifyClaude}"/>
          <CheckBox Content="Da Codex" IsChecked="{Binding NotifyCodex}"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="COSTI">
        <StackPanel>
          <CheckBox Content="Mostra costi (prezzi API di listino)" IsChecked="{Binding ShowCosts}"
                    ToolTip="Costo API equivalente in euro accanto ai token: listino LiteLLM (prezzi pubblicati da Anthropic e OpenAI) e tasso di riferimento BCE. Con un abbonamento non è la spesa reale. Spento, l'app non scarica né listino né tasso."/>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Label Content="Tasso di riserva: 1 € ="/>
            <!-- Testo, non double: FallbackRateInput accetta "1,14" e "1.14" (il convertitore di WPF in it-IT leggeva
                 "1.14" come 114). PropertyChanged: l'errore e lo stato di Salva seguono ogni tasto. -->
            <TextBox Grid.Column="1" MinWidth="60" Text="{Binding UsdPerEurText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Usato solo quando il tasso BCE non è disponibile (tra 0,5 e 2). Virgola o punto per i decimali."/>
            <Label Grid.Column="2" Content="$"/>
          </Grid>
          <TextBlock Text="{Binding UsdPerEurError}" Visibility="{Binding UsdPerEurErrorVisibility}"
                     Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding PricingStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,4"/>
          <Button Content="Apri cartella dati" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left"
                  ToolTip="Qui puoi creare prices-override.json per aggiungere o correggere il prezzo di un modello."/>
        </StackPanel>
      </GroupBox>

      <!-- Stato e comandi dal vivo di UpdateService (UpdatesViewModel, proprieta' Updates): non passano da Salva/Annulla.
           Solo "Controlla automaticamente" e' una preferenza della bozza, salvata insieme alle altre. -->
      <GroupBox x:Name="UpdatesGroup" Header="AGGIORNAMENTI">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Versione corrente"/>
            <TextBlock Grid.Column="1" Text="{Binding Updates.VersionText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Label Grid.Row="1" Content="Account GitHub"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Updates.AccountText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Label Grid.Row="2" Content="Ultimo controllo"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Updates.LastCheckText, Mode=OneWay}" VerticalAlignment="Center"/>
            <Label Grid.Row="3" Content="Stato"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Updates.PhaseText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </Grid>

          <!-- Messaggio dello stato: grigio di norma, Amber nella fase Error (due TextBlock per non introdurre stili
               locali). Gli errori sono Amber come i messaggi di stato del notch: Red sulla card (#2D2D31) si ferma a
               4.1:1, sotto il minimo 4.5:1 del testo normale. -->
          <TextBlock Text="{Binding Updates.Message, Mode=OneWay}" Visibility="{Binding Updates.MessageVisibility, Mode=OneWay}"
                     Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Updates.Message, Mode=OneWay}" Visibility="{Binding Updates.ErrorMessageVisibility, Mode=OneWay}"
                     Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Updates.CommandError, Mode=OneWay}" Visibility="{Binding Updates.CommandErrorVisibility, Mode=OneWay}"
                     Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,6,0,0"/>

          <StackPanel Visibility="{Binding Updates.ProgressVisibility, Mode=OneWay}" Margin="0,8,0,0">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.ProgressValue, Mode=OneWay}"/>
            <TextBlock Text="{Binding Updates.ProgressText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>

          <WrapPanel Margin="0,8,0,0">
            <Button Content="Collega GitHub e controlla" Command="{Binding Updates.ConnectCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Controlla ora" Command="{Binding Updates.CheckCommand}" Visibility="{Binding Updates.CheckVisibility, Mode=OneWay}"/>
            <Button Content="Scarica" Command="{Binding Updates.DownloadCommand}"/>
            <Button Content="Installa e riavvia" Command="{Binding Updates.InstallCommand}"/>
            <Button Content="Annulla collegamento" Command="{Binding Updates.CancelAuthenticationCommand}"
                    Visibility="{Binding Updates.CancelAuthenticationVisibility, Mode=OneWay}"/>
            <Button Content="Scollega account" Command="{Binding Updates.DisconnectCommand}" Visibility="{Binding Updates.DisconnectVisibility, Mode=OneWay}"/>
            <Button Content="Apri release" Command="{Binding Updates.OpenReleaseCommand}"
                    ToolTip="Apre nel browser la pagina GitHub della release proposta (o l'elenco delle release)."/>
          </WrapPanel>

          <Expander Header="{Binding Updates.NotesHeader, Mode=OneWay}" Visibility="{Binding Updates.NotesVisibility, Mode=OneWay}" Margin="0,6,0,0">
            <TextBox Text="{Binding Updates.Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0"/>
          </Expander>

          <CheckBox Content="Controlla automaticamente gli aggiornamenti" IsChecked="{Binding UpdatesAutoCheck}" Margin="0,8,0,4"
                    ToolTip="Un controllo 15 secondi dopo l'avvio e poi ogni 6 ore, solo con un account GitHub collegato. La scelta vale dopo Salva."/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="SISTEMA">
        <StackPanel>
          <CheckBox Content="Avvio automatico con Windows" IsChecked="{Binding AutoStartEnabled}"/>
          <Button Content="Apri cartella log" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button Content="Annulla" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Salva" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,2,0,2"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
