<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AIUsageMonitor.App.Controls">
  <!-- Stili "Premium" (spec 2026-09-24, sezione 7.2). Ogni template e' esplicito, cosi' non resta nessuna cromatura
       chiara di default. I pennelli arrivano da Theme.xaml, unito PRIMA di questo dizionario in App.xaml. -->

  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource Focus}" BorderThickness="1.5" CornerRadius="12" Margin="-3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Button: capsula secondaria -->
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primario: capsula bianca con testo scuro -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pulsanti del notch: non prendono il focus (la finestra non si attiva mai) e, essendo Button, marcano il click
       Handled, quindi non arrivano al pannello e non lo fissano/sbloccano. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{StaticResource Tile}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillButton" TargetType="Button">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- CheckBox come interruttore: etichetta a sinistra, interruttore 44x26 a destra della riga. Il pomello bianco
       (spento) e la traccia Toggle (acceso) superano 3:1 sulla card: ColorContrastTests. -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel Background="Transparent" LastChildFill="True">
            <Border x:Name="Track" DockPanel.Dock="Right" Width="44" Height="26" CornerRadius="13"
                    Background="{StaticResource SurfacePressed}" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <!-- Il Setter di un trigger puo' puntare solo a un elemento del template (MC4111 su una trasformazione con
                 nome): si sostituisce la RenderTransform del pomello, come per il chevron dell'Expander. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Toggle}"/>
              <Setter TargetName="Knob" Property="RenderTransform">
                <Setter.Value><TranslateTransform X="18"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.92"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
              <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Focus}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
            <!-- Niente Margin="{TemplateBinding Padding}": TextBox passa gia' il suo Padding a PART_ContentHost, e
                 applicarlo due volte spingeva il testo a 20 px dal bordo invece di 10. -->
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMuted}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox (popup scuro incluso) -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="10">
      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0"
            Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfacePressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                   PopupAnimation="Fade" Focusable="False">
              <Border Background="{StaticResource Card}" BorderBrush="{StaticResource NotchBorder}" BorderThickness="1" CornerRadius="12"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,6,0,0" Padding="0,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- GroupBox come card (le Impostazioni usano CardBorder; resta per qualunque GroupBox futuro) -->
  <Style TargetType="GroupBox">
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="18" Padding="18">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,10"
                                TextElement.FontSize="15" TextElement.FontWeight="SemiBold"/>
              <ContentPresenter/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="0,6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource Hairline}"/>
    <Setter Property="Margin" Value="0,8"/>
  </Style>

  <!-- ScrollBar sottile: pollice da 6 px che si scurisce sotto il mouse. MinWidth (e MinHeight in orizzontale) a zero:
       lo stile di sistema li imposta alla larghezza standard di Windows (circa 17 px) e vincerebbero sulla Width. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <!-- I due RepeatButton sono invisibili ma servono: senza di loro il click sulla parte vuota della
                   barra non pagina piu' il contenuto. Essendo ButtonBase marcano anche il click come Handled,
                   quindi l'evento non risale al bordo del pannello del notch, che lo interpreterebbe come
                   fissa/sblocca (vedi il commento su Tab_MouseLeftButtonDown in NotchWindow.xaml.cs). -->
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageBack" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageForward" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bd" Background="{StaticResource SurfacePressed}" CornerRadius="3" Margin="1"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Idle}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Su una barra orizzontale i comandi PageUp/PageDown non si applicano e la direzione del Track va
                 invertita: senza questo trigger il click sulla parte vuota non pagina (e quindi non verrebbe
                 marcato Handled). Oggi entrambe le ScrollViewer hanno HorizontalScrollBarVisibility="Disabled",
                 ma il template resta corretto se un domani ne comparisse una. -->
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              <Setter TargetName="PageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
              <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="Auto"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ProgressBar da 8 px con il gradiente del tono normale e il riflesso (download degli aggiornamenti). ProgressBar
       dimensiona da solo PART_Indicator rispetto a PART_Track, quindi i due nomi sono obbligatori. Il riflesso gira
       solo con le animazioni di Windows attive; in modo indeterminato l'indicatore pulsa (anche questo solo con le
       animazioni attive). -->
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource ToneNormalBrush}"/>
    <Setter Property="Background" Value="{StaticResource BarTrack}"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" ClipToBounds="True">
              <Border x:Name="Sheen" Width="60" HorizontalAlignment="Left" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#00FFFFFF"/>
                    <GradientStop Offset="0.5" Color="#8CFFFFFF"/>
                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform><TranslateTransform x:Name="SheenShift" X="-60"/></Border.RenderTransform>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Enabled, Source={x:Static c:MotionSettings.Instance}}" Value="True">
              <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
              <DataTrigger.EnterActions>
                <BeginStoryboard x:Name="SheenLoop">
                  <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                    <DoubleAnimation Storyboard.TargetName="SheenShift" Storyboard.TargetProperty="X" From="-60" To="420" Duration="0:0:1.7"/>
                    <DoubleAnimation Storyboard.TargetName="SheenShift" Storyboard.TargetProperty="X" From="420" To="420" BeginTime="0:0:1.7" Duration="0:0:1.1"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SheenLoop"/></DataTrigger.ExitActions>
            </DataTrigger>
            <!-- Anche la pulsazione e' un ciclo: solo con le animazioni di Windows attive e a 30 fps, come il riflesso;
                 senza animazioni l'indicatore indeterminato resta pieno e fermo. -->
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding Enabled, Source={x:Static c:MotionSettings.Instance}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                    <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.8"/>
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Expander (note della release): intestazione piatta con chevron che ruota. -->
  <ControlTemplate x:Key="ExpanderHeaderToggle" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="6,6">
      <StackPanel Orientation="Horizontal">
        <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
              Margin="2,0,10,0" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
        </Path>
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/></Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chevron" Property="RenderTransform">
          <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Template="{StaticResource ExpanderHeaderToggle}" Cursor="Hand"
                          FocusVisualStyle="{StaticResource FocusVisual}" Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,4,0,0"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource TextDisabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schede segmentate: capsula Tile con le schede a larghezza uguale; la scheda attiva e' una capsula Surface.
       Il contenuto sta in PART_SelectedContentHost, che la finestra Impostazioni fa entrare in dissolvenza. -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Tile}" CornerRadius="14" Padding="4" Margin="0,0,0,16">
              <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,0">
            <ContentPresenter x:Name="HeaderHost" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
            <!-- Il grassetto va solo sull'intestazione: il contenuto della scheda eredita dal TabItem (albero logico),
                 quindi un FontWeight sul TabItem renderebbe semibold tutto il testo della scheda. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              <Setter TargetName="HeaderHost" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
