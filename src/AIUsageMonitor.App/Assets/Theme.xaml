<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette "Premium" (spec 2026-09-24, sezione 4). I valori sono fissati da ThemePaletteTests e i rapporti di
       contrasto da ColorContrastTests: cambiarne uno qui senza aggiornare i test fa fallire la build. -->

  <!-- Superfici -->
  <SolidColorBrush x:Key="NotchBackground" Color="#F5121216"/>
  <SolidColorBrush x:Key="WindowBackground" Color="#FF121216"/>
  <SolidColorBrush x:Key="Card" Color="#FF1B1B21"/>
  <SolidColorBrush x:Key="Tile" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="Surface" Color="#FF26262E"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#FF30303A"/>
  <SolidColorBrush x:Key="SurfacePressed" Color="#FF3A3A45"/>
  <SolidColorBrush x:Key="NotchBorder" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="Hairline" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="BarTrack" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="RingTrack" Color="#1AFFFFFF"/>

  <!-- Testo e accenti -->
  <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F7"/>
  <SolidColorBrush x:Key="TextMuted" Color="#FFA1A1AA"/>
  <SolidColorBrush x:Key="TextDisabled" Color="#FF71717A"/>
  <SolidColorBrush x:Key="Accent" Color="#FFF5F5F7"/>
  <SolidColorBrush x:Key="AccentText" Color="#FF121216"/>
  <SolidColorBrush x:Key="Toggle" Color="#FF22C55E"/>
  <SolidColorBrush x:Key="Focus" Color="#FF7AA2F7"/>

  <!-- Colori degli agenti: solo cerchio dell'icona e alone della card. -->
  <SolidColorBrush x:Key="BrandClaude" Color="#FFD97757"/>
  <SolidColorBrush x:Key="BrandCodex" Color="#FF10A37F"/>

  <!-- Stati: colore pieno (anelli, pallini), testo, riempimento al 14 % (avatar, pillole). -->
  <SolidColorBrush x:Key="Success" Color="#FF4ADE80"/>
  <SolidColorBrush x:Key="SuccessText" Color="#FF86EFAC"/>
  <SolidColorBrush x:Key="SuccessFill" Color="#244ADE80"/>
  <SolidColorBrush x:Key="Warning" Color="#FFFBBF24"/>
  <SolidColorBrush x:Key="WarningText" Color="#FFFCD34D"/>
  <SolidColorBrush x:Key="WarningFill" Color="#24FBBF24"/>
  <SolidColorBrush x:Key="Danger" Color="#FFF87171"/>
  <SolidColorBrush x:Key="DangerText" Color="#FFFCA5A5"/>
  <SolidColorBrush x:Key="DangerFill" Color="#24F87171"/>
  <SolidColorBrush x:Key="Idle" Color="#FF71717A"/>
  <SolidColorBrush x:Key="IdleFill" Color="#2471717A"/>

  <!-- Chiavi della palette precedente ancora referenziate da template non ancora rifatti: stessi colori di stato. -->
  <SolidColorBrush x:Key="Green" Color="#FF4ADE80"/>
  <SolidColorBrush x:Key="Amber" Color="#FFFBBF24"/>
  <SolidColorBrush x:Key="Red" Color="#FFF87171"/>
  <SolidColorBrush x:Key="Grey" Color="#FF71717A"/>
  <SolidColorBrush x:Key="Badge" Color="#14FFFFFF"/>

  <!-- Gradienti delle barre per tono, da sinistra a destra. -->
  <LinearGradientBrush x:Key="ToneNormalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#FF22C55E"/>
    <GradientStop Offset="1" Color="#FF86EFAC"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ToneWarningBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#FFF59E0B"/>
    <GradientStop Offset="1" Color="#FFFCD34D"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ToneCriticalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#FFEF4444"/>
    <GradientStop Offset="1" Color="#FFFCA5A5"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ToneStaleBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="#FF52525B"/>
    <GradientStop Offset="1" Color="#FF71717A"/>
  </LinearGradientBrush>

  <!-- Riflesso delle barre: banda bianca al 55 % che sfuma a zero ai lati. BarSheen e' la banda che disegna UsageBar;
       la ProgressBar di Controls.xaml usa i due colori per un pennello suo, perche' ne anima la posizione. -->
  <Color x:Key="SheenClearColor">#00FFFFFF</Color>
  <Color x:Key="SheenPeakColor">#8CFFFFFF</Color>
  <LinearGradientBrush x:Key="BarSheen" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Offset="0" Color="{StaticResource SheenClearColor}"/>
    <GradientStop Offset="0.5" Color="{StaticResource SheenPeakColor}"/>
    <GradientStop Offset="1" Color="{StaticResource SheenClearColor}"/>
  </LinearGradientBrush>

  <!-- Alone dell'agente nell'angolo in alto a sinistra della card: 160x130 px assoluti, dal 30 % a zero. -->
  <RadialGradientBrush x:Key="ClaudeGlow" MappingMode="Absolute" Center="0,0" GradientOrigin="0,0" RadiusX="160" RadiusY="130">
    <GradientStop Offset="0" Color="#4DD97757"/>
    <GradientStop Offset="1" Color="#00D97757"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="CodexGlow" MappingMode="Absolute" Center="0,0" GradientOrigin="0,0" RadiusX="160" RadiusY="130">
    <GradientStop Offset="0" Color="#4D10A37F"/>
    <GradientStop Offset="1" Color="#0010A37F"/>
  </RadialGradientBrush>

  <!-- Caratteri: Display per numeri grandi e titoli, Text per il resto; Segoe UI su Windows 10. -->
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Solo FontFamily. Foreground/FontSize NON vanno qui: il testo-stringa di Button, CheckBox, Label e header di
       GroupBox passa da un ContentPresenter che genera un TextBlock, e un setter di stile batte l'ereditarieta' nella
       precedenza WPF. I default di corpo stanno sulle radici che li possiedono (notch, finestre). -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
  </Style>
</ResourceDictionary>
