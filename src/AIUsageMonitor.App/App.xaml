<Application x:Class="AIUsageMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/Icons.xaml"/>
        <ResourceDictionary Source="Assets/Theme.xaml"/>
        <!-- Dopo Theme.xaml: Controls.xaml risolve i pennelli della palette con StaticResource. -->
        <ResourceDictionary Source="Assets/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
